{
  "name": "gameshow",
  "version": "1.0.0",
  "private": true,
  "description": "游戏/软件作品展示分享平台",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node server/index.js\" \"vite --config vite.config.mjs\"",
    "build": "vite build --config vite.config.mjs",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  }
}
